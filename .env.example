# ---------------------------------------------------------------------------
# AskDoc environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=aiappdb
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
# Local / venv (host Postgres on 5433) or Docker Compose (postgres:5432)
DATABASE_URL=postgresql://your_username:your_password@localhost:5433/aiappdb

# --- Auth / JWT -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret

# --- Redis ----------------------------------------------------------------
# Host Redis (localhost) or Docker Compose (redis:6379)
REDIS_URL=redis://localhost:6379/0

# --- LLM (Groq) -----------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

# --- Embeddings / Reranker ------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector store ---------------------------------------------------------
VECTOR_COLLECTION=document_chunks
CHROMA_PERSIST_DIR=chroma_db

# --- File storage ---------------------------------------------------------
UPLOAD_DIR=uploads

# --- AI response cache ----------------------------------------------------
CACHE_TTL_SECONDS=300
