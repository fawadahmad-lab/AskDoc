# ---------------------------------------------------------------------------
# Docly environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=aiappdb
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
# Local / venv (host Postgres on 5433) or Docker Compose (postgres:5432)
# PRODUCTION (Supabase): paste the "Session pooler" connection string from
# Supabase > Project Settings > Database here — e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (keep the default DATABASE_URL below for local docker compose)
DATABASE_URL=postgresql://your_username:your_password@localhost:5433/aiappdb

# --- Auth / JWT -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED in production (Railway): the app refuses to start if this is unset
# or the unsafe default in production.
SECRET_KEY=replace-with-a-random-secret
# "development" | "production". In production, SECRET_KEY must be set, and on
# Railway set ENVIRONMENT=production in Variables (not in a .env file).
ENVIRONMENT=development

# How long a session lasts when the user checks "Remember me" at login (days).
# The default 30-minute session (ACCESS_TOKEN_EXPIRE_MINUTES in config) is unchanged.
REMEMBER_ME_DAYS=30

# --- Secret-at-rest encryption (per-user API keys) -------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production: the app refuses to start without it. In development
# a gitignored .encryption_key is generated automatically when this is unset.
ENCRYPTION_KEY=replace-with-a-fernet-key

# --- Security -------------------------------------------------------------
# Comma-separated allowed browser origins (CORS). Production: your Vercel
# origin, e.g. https://docly.vercel.app (or your custom domain)
CORS_ORIGINS=http://localhost:3000
# Comma-separated Host-header allowlist (TrustedHostMiddleware). Production:
# your Railway host + custom domain, e.g. docly-production.up.railway.app
TRUSTED_HOSTS=localhost,127.0.0.1,*.railway.app

# Auth rate limiting (per client IP, fixed window; 0 disables)
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=10
SIGNUP_RATE_WINDOW_SECONDS=3600
VERIFY_RATE_LIMIT=10
VERIFY_RATE_WINDOW_SECONDS=900
RESEND_RATE_LIMIT=3
RESEND_RATE_WINDOW_SECONDS=3600
FORGOT_RATE_LIMIT=3
FORGOT_RATE_WINDOW_SECONDS=3600
RESET_RATE_LIMIT=10
RESET_RATE_WINDOW_SECONDS=900

# --- Email verification / SMTP ---------------------------------------------
# Only mailboxes on these domains can register (comma-separated, lowercase).
ALLOWED_EMAIL_DOMAINS=gmail.com
# Gmail SMTP sender via an App Password (Google Account > Security > App
# passwords). REQUIRED in production: new accounts can't be activated without
# these. In development, emails print to the server log instead of sending.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS=true
EMAIL_SMTP_USER=your-gmail-address@gmail.com
EMAIL_SMTP_PASSWORD=your-16-char-app-password
EMAIL_SENDER=your-gmail-address@gmail.com
# Origin of the deployed frontend; verify/reset links point here. REQUIRED in
# production (must not be http://localhost:3000). Set to your Vercel origin.
FRONTEND_URL=http://localhost:3000
# Verification code / reset-token lifetimes.
VERIFY_CODE_TTL_MINUTES=10
RESET_TOKEN_TTL_MINUTES=30

# --- Redis ----------------------------------------------------------------
# Host Redis (localhost) or Docker Compose (redis:6379). Production (Railway):
# add a Redis plugin in the Railway dashboard and paste its URL here, e.g.
# redis://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- LLM (Groq) -----------------------------------------------------------
# Deployment-level key, used ONLY as a fallback for the dev/evaluation harness
# (app.rag.llm fallback + RAGAS judge). Product users bring their own key at
# signup; it is verified live and stored encrypted per user.
GROQ_API_KEY=your-groq-api-key
# Optional: HuggingFace token only if you override EMBEDDING_MODEL/RERANKER_MODEL
# with a gated model (the defaults are public and need no token).
# HF_TOKEN=

# Generation model used by the RAG pipeline (app.rag.llm).
GROQ_MODEL=openai/gpt-oss-20b

# --- Runtime --------------------------------------------------------------
# Railway sets PORT automatically — no need to define it there. Uvicorn in the
# container reads it to pick up Railway's random port.
# PORT=8000



# --- Embeddings / Reranker ------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector store ---------------------------------------------------------
VECTOR_COLLECTION=document_chunks
CHROMA_PERSIST_DIR=chroma_db

# --- File storage ---------------------------------------------------------
UPLOAD_DIR=uploads

# --- AI response cache ----------------------------------------------------
CACHE_TTL_SECONDS=300

# Experimental: Langfuse configuration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=


# Ragas evaluation

# Fast, deterministic instruct judge with an independent quota. The production
# LLM (gpt-oss-20b) and compound-mini aliases can exhaust their daily token
# quotas when used as a ragas judge; gpt-oss-120b has a separate budget.
RAGAS_EVALUATION_MODEL=openai/gpt-oss-120b

# Cap the number of questions scored in one RAGAS run (0 = all). Lower it for
# quick smoke runs; leave 0 for the full evaluation.
MAX_EVALUATION_SAMPLES=0